# Copy to .env.local only if no local configuration exists. Never commit a real key.
# Use a Free tier, unbilled AI Studio project; see docs/gemini-activation.md.
AI_MODE=mock
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
# Required for any server live calls (including local classroom testing).
DEMO_ACCESS_CODE=
# Set true only after running and reviewing live acceptance tests.
LIVE_EVAL_PASSED=false
# Hosted live calls also require a private deployment protected at the hosting layer.
CLASSROOM_DEPLOYMENT_PROTECTED=false
